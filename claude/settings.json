  "model": "opus[1m]",
  "hooks": {},
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "clippy@clippy-framework": true,
    "claude-code-setup@claude-plugins-official": true,
    "skeptic@skepticism": true
  },
  "extraKnownMarketplaces": {
    "clippy-framework": {
      "source": {
        "source": "github",
        "repo": "diego-vicente/clippy-framework"
      }
    },
    "skepticism": {
      "source": {
        "source": "url",
