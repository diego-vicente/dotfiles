#!/bin/sh
#
# Attach to a named tmux workspace on claw. Deployed to ~/bin/tmux-connect.
#
#   tmux-connect work
#   tmux-connect personal
#
# Same two workspaces as the laptop, on purpose — one habit, both machines.
# The directories differ because this box has a different layout: work repos
# are under ~/Projects (CartoDB remotes) and personal ones under ~/repos
# (clippy-ai-dev remotes). There is no ~/Projects/Personal here, and inventing
# one just to match a path would be worse than pointing at what exists.
#
# Plain POSIX sh on purpose: the login shell here is bash (so SSH automation
# keeps working) while tmux panes run fish, so this has to work from either.
# The laptop's equivalent is a fish function; this box can't assume fish.

set -eu

TMUX_BIN="/usr/bin/tmux"

WORKSPACE_WORK="work"
WORKSPACE_PERSONAL="personal"

DIR_WORK="${HOME}/Projects"
DIR_PERSONAL="${HOME}/repos"

usage() {
	echo "usage: $(basename "$0") {${WORKSPACE_WORK}|${WORKSPACE_PERSONAL}}"
	echo
	echo "  ${WORKSPACE_WORK}      -> ${DIR_WORK}"
	echo "  ${WORKSPACE_PERSONAL}  -> ${DIR_PERSONAL}"
	echo
	echo "  Attaches in the current terminal, or switches session if already"
	echo "  inside tmux. Creates the session detached first, so it survives"
	echo "  even if this shell goes away."
}

case "${1:-}" in
	-h|--help) usage; exit 0 ;;
esac

[ "$#" -eq 1 ] || { usage >&2; exit 64; }

workspace="$1"
case "$workspace" in
	"$WORKSPACE_WORK")     workdir="$DIR_WORK" ;;
	"$WORKSPACE_PERSONAL") workdir="$DIR_PERSONAL" ;;
	*)
		echo "tmux-connect: unknown workspace '$workspace'" >&2
		echo "known: ${WORKSPACE_WORK} ${WORKSPACE_PERSONAL}" >&2
		exit 2
		;;
esac

[ -d "$workdir" ] || { echo "tmux-connect: no such directory: $workdir" >&2; exit 66; }

# Detached first: the session then outlives this shell, which is the whole
# reason for running agents on this box.
"$TMUX_BIN" new-session -A -d -s "$workspace" -c "$workdir"

# Nesting tmux inside tmux means doubled prefixes for every keystroke.
if [ -n "${TMUX:-}" ]; then
	exec "$TMUX_BIN" switch-client -t "$workspace"
else
	exec "$TMUX_BIN" attach-session -t "$workspace"
fi
