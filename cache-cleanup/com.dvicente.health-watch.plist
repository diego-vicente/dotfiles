<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dvicente.health-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dvicente/.config/cache-cleanup/health-watch.sh</string>
    </array>

    <!-- Every 30 minutes. The checks are cheap: df, tmutil, sysctl, vm_stat. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Run once at login too, so a machine that boots already short of space
         says so immediately rather than 30 minutes later. -->
    <key>RunAtLoad</key>
    <true/>

    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/dvicente/Library/Logs/health-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dvicente/Library/Logs/health-watch.log</string>
</dict>
</plist>
