<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dvicente.cache-cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dvicente/.config/cache-cleanup/cleanup.sh</string>
    </array>

    <!-- Sunday at 10:00. launchd runs a missed job once the Mac wakes, so a
         weekend shutdown only delays the run, it does not skip it. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Never on login. A cleanup that fights the login rush is the opposite
         of what this agent is for. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Yield to anything the user is doing. The work is not urgent. -->
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/dvicente/Library/Logs/cache-cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dvicente/Library/Logs/cache-cleanup.log</string>
</dict>
</plist>
