.DS_Store
.idea
*.log
tmp/

# 

# Ignore everything in the passwords directory but .gpg files
passwords/*
!passwords/*.asc

# Ignore the global Poetry environment
/poetry_venv

# 1Password service-account token (loaded by the shells, never committed)
.config/op/
service-account-token

# Local backups made by scripts/link-dotfiles.sh, and ad hoc .bak copies
/backup/
*.bak
*.bak.*
*.bak-*
