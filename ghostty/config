theme = catppuccin-mocha.conf
font-thicken = true

# Configure for macOS
# shell-integration must stay EXPLICIT: Ghostty auto-detects the shell from the
# basename of `command`, so anything launched as tmux would get no injection.
shell-integration = fish
# no-cursor: tmux and the integration otherwise fight over cursor shape.
# ssh-terminfo/ssh-env: remote hosts have no xterm-ghostty entry, and tmux there
# hard-fails with "missing or unsuitable terminal". This installs it on connect.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
desktop-notifications = true
macos-option-as-alt = true

# tmux owns session state, so don't let Ghostty restore a second, stale copy.
window-save-state = never
# Ghostty only ever sees `tmux: client` and cannot inspect the pane tree, so the
# "are you at a prompt" heuristic never fires and this prompts on every close.
confirm-close-surface = false

# notify-on-command-finish = unfocused
# notify-on-command-finish-after = 30s

keybind = shift+enter=text:\n

# Moved off cmd+; so that key can become the tmux leader (see below).
keybind = global:cmd+apostrophe=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 50%,50%

# tmux leader on cmd+;
#
# macOS never sends Cmd to the terminal, so tmux cannot bind it. Ghostty
# catches the chord and injects 0x1c (C-\), which tmux.conf sets as `prefix2`.
# Ghostty keybinds fire before tmux sees any input, so there is no collision
# with the primary C-Space prefix — both work, and only C-Space works on the
# phone, where there is no Cmd key.
keybind = cmd+semicolon=text:\x1c

# ===========================================================================
# tmux owns everything below the window level
#
# Ghostty is a display surface only: it draws one tmux client per macOS window
# and gets out of the way. Every split, tab and navigation binding is unbound
# here so the keystroke falls through to tmux, which handles sessions, windows,
# panes and movement between them. See tmux/tmux.conf for the replacements.
#
# Window-level keys are deliberately KEPT (cmd+n, cmd+w, cmd+q): macOS still
# owns window geometry and Spaces. That layer is not tmux's job.
# ===========================================================================

# Splits -> tmux prefix + | and -, prefix + hjkl, prefix + z
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+enter=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+alt+left=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+ctrl+up=unbind
keybind = cmd+ctrl+down=unbind
keybind = cmd+ctrl+left=unbind
keybind = cmd+ctrl+right=unbind
keybind = cmd+ctrl+equal=unbind

# GOTCHA: cmd+h is also a system-level "Hide Window" binding. To let tmux see
# it at all you must clear it in:
#   > Settings > Keyboard > Keyboard Shortcuts...
keybind = cmd+h=unbind
keybind = cmd+j=unbind
keybind = cmd+k=unbind
keybind = cmd+l=unbind

# Tabs -> tmux windows: prefix + c, alt+1..5, prefix + n/p, prefix + Tab
keybind = cmd+t=unbind
keybind = cmd+alt+w=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = cmd+1=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+2=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+3=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+4=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+5=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_9=unbind

# NOT DONE ON PURPOSE: Ghostty can fake native chords by injecting the tmux
# prefix, e.g. `keybind = cmd+1=text:\x01\x31` for a C-a prefix. Our prefix is
# C-Space, which is NUL (\x00), and a NUL byte in a text: action is not
# reliably delivered. Use the tmux bindings directly instead.
