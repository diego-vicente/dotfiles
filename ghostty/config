# Follows the macOS appearance natively — no appearance-sync handler needed.
# Ghostty re-reads this on system light/dark switch and repaints live.
theme = light:catppuccin-latte.conf,dark:catppuccin-mocha.conf
font-thicken = true

# Configure for macOS
# shell-integration must stay EXPLICIT: Ghostty auto-detects the shell from the
# basename of `command`, so anything launched as tmux would get no injection.
shell-integration = fish
# no-cursor: tmux and the integration otherwise fight over cursor shape.
# ssh-terminfo/ssh-env: remote hosts have no xterm-ghostty entry, and tmux there
# hard-fails with "missing or unsuitable terminal". This installs it on connect.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
desktop-notifications = true
macos-option-as-alt = true

# tmux owns session state, so don't let Ghostty restore a second, stale copy.
window-save-state = never

# Ghostty pads the grid by window-padding-x/y (2 each, the default) and paints
# that strip with `background`. A filled status bar therefore stops at the grid
# edge and gets framed in canvas colour — the bar reads as a floating rectangle
# rather than a band across the top. `extend` paints the padding with the
# nearest cell's background instead, so the bar runs to the window edge.
#
# The documented heuristics that suppress extending — default-background cells
# in the nearest row, prompt rows, perfect-fit powerline glyphs — apply only to
# primary-screen applications. tmux runs on the alternate screen, and every cell
# in the bar carries an explicit background anyway, so neither exemption bites.
window-padding-color = extend

# NOT adjust-icon-height. It was set here to fix undersized agent markers in the
# status bar, on the theory that the icons were capped shorter than the text.
# The real cause was the cell AFTER each icon. Ghostty renders a nerd-font glyph
# across two cells when the next cell is blank and shrinks it to one cell when
# that cell is occupied, and the status bar packed a digit against one glyph in
# a single place. Every other marker already had a space after it and always
# looked right, which is what disproved the font theory.

# Ghostty only ever sees `tmux: client` and cannot inspect the pane tree, so the
# "are you at a prompt" heuristic never fires and this prompts on every close.
confirm-close-surface = false

# notify-on-command-finish = unfocused
# notify-on-command-finish-after = 30s

keybind = shift+enter=text:\n

# Moved off cmd+; so that key can become the tmux leader (see below).
keybind = global:cmd+apostrophe=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 50%,50%

# tmux leader on cmd+;
#
# macOS never sends Cmd to the terminal, so tmux cannot bind the chord at all.
# Ghostty catches it and writes 0x1c into the pty, which tmux reads as C-\ and
# tmux.conf sets as `prefix`. Every other cmd chord below injects this same byte
# followed by a key, so they all follow this one.
keybind = cmd+semicolon=text:\x1c

# ===========================================================================
# tmux owns everything below the window level
#
# Ghostty is a display surface only: it draws one tmux client per macOS window
# and gets out of the way. Its own split/tab bindings are either UNBOUND (so the
# keystroke falls through) or TRANSLATED into a tmux prefix sequence, so the
# familiar cmd chords drive tmux instead of Ghostty. See tmux/tmux.conf.
#
# Window-level keys are deliberately KEPT (cmd+n, cmd+w, cmd+q): macOS still
# owns window geometry and Spaces. That layer is not tmux's job.
# ===========================================================================

# Ghostty no longer *performs* these actions — it injects the tmux prefix byte
# (0x1c = C-\, our prefix) followed by the key, so the tmux binding you already
# have does the work. macOS never transmits Cmd to the terminal, so this
# translation is the only way a cmd chord can drive tmux at all.
#
# Payloads must not contain "=": Ghostty splits trigger from action on the
# FIRST "=", so an action containing one is misparsed.

# Panes
keybind = cmd+d=text:\x1c|
keybind = cmd+shift+d=text:\x1c-
keybind = cmd+h=text:\x1ch
keybind = cmd+j=text:\x1cj
keybind = cmd+k=text:\x1ck
keybind = cmd+l=text:\x1cl
keybind = cmd+shift+enter=text:\x1cz

# Windows (tmux windows — what Ghostty would call tabs)
keybind = cmd+t=text:\x1ct
# prev / next window. \x1c is the prefix; [ and ] are the tmux bindings.
keybind = cmd+shift+h=text:\x1c[
keybind = cmd+shift+l=text:\x1c]
keybind = cmd+1=text:\x1c1
keybind = cmd+digit_1=text:\x1c1
keybind = cmd+2=text:\x1c2
keybind = cmd+digit_2=text:\x1c2
keybind = cmd+3=text:\x1c3
keybind = cmd+digit_3=text:\x1c3
keybind = cmd+4=text:\x1c4
keybind = cmd+digit_4=text:\x1c4
keybind = cmd+5=text:\x1c5
keybind = cmd+digit_5=text:\x1c5

# Sessions
keybind = cmd+s=text:\x1cs

# GOTCHA: cmd+h is also a system-level "Hide Window" shortcut and never reaches
# Ghostty until you clear it in:
#   > Settings > Keyboard > Keyboard Shortcuts...
#
# DELIBERATELY NOT BOUND: cmd+w. It still closes the Ghostty window, which is
# what you want — tmux's kill-pane lives on prefix + x.

# Still unbound: Ghostty's own split/tab navigation, which tmux replaces.
keybind = cmd+alt+up=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+alt+left=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+ctrl+up=unbind
keybind = cmd+ctrl+down=unbind
keybind = cmd+ctrl+left=unbind
keybind = cmd+ctrl+right=unbind
keybind = cmd+ctrl+equal=unbind
keybind = cmd+alt+w=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_9=unbind
